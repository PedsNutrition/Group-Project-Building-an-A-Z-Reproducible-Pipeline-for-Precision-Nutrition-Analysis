evaluate_imputation <- function(data, TARGET, label) {
message("Evaluating: ", label, " ...")
evaluate_imputation <- function(data, TARGET, label) {
message("Evaluating: ", label, " ...")
# Use the 'data' argument (not the global df_final)
model_data <- data %>%
select(all_of(TARGET), where(is.numeric)) %>%
drop_na()
if (nrow(model_data) < 30) {
warning(label, " — too few rows after cleaning. Skipping.")
return(tibble(method = label, RMSE = NA_real_, MAE = NA_real_, R2 = NA_real_))
}
set.seed(42)
ctrl <- trainControl(method = "cv", number = 5,
verboseIter = FALSE,
savePredictions = "final")
formula_obj <- as.formula(paste(TARGET, "~ ."))
model <- tryCatch(
train(formula_obj, data = model_data,
method     = "rf",
trControl  = ctrl,
importance = FALSE,
ntree      = 100),
error = function(e) {
message("  Model failed: ", conditionMessage(e))
NULL
}
)
if (is.null(model)) {
return(tibble(method = label, RMSE = NA_real_, MAE = NA_real_, R2 = NA_real_))
}
best_row <- model$results %>%
arrange(RMSE) %>%
slice(1)
# FIX: compute MAE from saved predictions instead of non-existent column
mae_val <- tryCatch({
preds <- model$pred %>% arrange(rowIndex) %>% slice(1:nrow(.))
mean(abs(preds$obs - preds$pred))
}, error = function(e) NA_real_)
tibble(
method = label,
RMSE   = round(best_row$RMSE,     4),
MAE    = round(mae_val,            4),
R2     = round(best_row$Rsquared, 4)
)
}
