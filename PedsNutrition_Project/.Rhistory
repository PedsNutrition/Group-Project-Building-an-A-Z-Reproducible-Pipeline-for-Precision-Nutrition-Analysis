if (nrow(model_data) < 30) {
warning(paste(label, "— too few rows after cleaning. Skipping."))
return(tibble(method = label, RMSE = NA, MAE = NA, R2 = NA))
}
set.seed(42)
ctrl <- trainControl(method = "cv", number = 5, verboseIter = FALSE)
