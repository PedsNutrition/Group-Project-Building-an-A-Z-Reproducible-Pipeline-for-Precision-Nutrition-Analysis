results_list <- list()
df_complete <- df_final %>% drop_na()
cat("\nComplete cases:", nrow(df_complete), "of", nrow(df_final),
sprintf("(%.1f%%)\n", 100 * nrow(df_complete) / nrow(df_final)))
results_list[["Complete Case"]] <- evaluate_imputation(df_complete, TARGET, "Complete Case")
mode_val <- function(x) {
ux <- na.omit(unique(x))
ux[which.max(tabulate(match(x, ux)))]
}
df_mean_imp <- df_final %>%
mutate(across(where(is.numeric),  ~ ifelse(is.na(.), mean(., na.rm = TRUE), .)),
across(where(is.character), ~ ifelse(is.na(.), mode_val(.), .)),
across(where(is.factor),    ~ ifelse(is.na(.), mode_val(.), .) %>% as.factor()))
results_list[["Mean/Mode"]] <- evaluate_imputation(df_mean_imp, TARGET, "Mean/Mode")
df_median_imp <- df_final %>%
mutate(across(where(is.numeric),  ~ ifelse(is.na(.), median(., na.rm = TRUE), .)),
across(where(is.character), ~ ifelse(is.na(.), mode_val(.), .)),
across(where(is.factor),    ~ ifelse(is.na(.), mode_val(.), .) %>% as.factor()))
results_list[["Median/Mode"]] <- evaluate_imputation(df_median_imp, TARGET, "Median/Mode")
cat("\n=== evaluate_imputation() result ===\n")
print(results_list[["Mean/Mode"]])
print(results_list[["Mean/Mode"]])
results_list[["Mean/Mode"]] <- evaluate_imputation(df_mean_imp, TARGET, "Mean/Mode")
print(results_list[["Mean/Mode"]])
results_list[["Mean/Mode"]] <- evaluate_imputation(df_mean_imp, TARGET, "Mean/Mode")
print(results_list[["Mean/Mode"]])
df_median_imp <- df_final %>%
mutate(across(where(is.numeric),  ~ ifelse(is.na(.), median(., na.rm = TRUE), .)),
across(where(is.character), ~ ifelse(is.na(.), mode_val(.), .)),
across(where(is.factor),    ~ ifelse(is.na(.), mode_val(.), .) %>% as.factor()))
results_list[["Median/Mode"]] <- evaluate_imputation(df_median_imp, TARGET, "Median/Mode")
cat("\nRunning kNN imputation (k=5)...\n")
df_knn_imp <- tryCatch({
VIM::kNN(df_final, k = 5, imp_var = FALSE)
}, error = function(e) {
message("kNN failed: ", conditionMessage(e))
NULL
})
if (!is.null(df_knn_imp)) {
results_list[["kNN (k=5)"]] <- evaluate_imputation(df_knn_imp, TARGET, "kNN (k=5)")
} else {
results_list[["kNN (k=5)"]] <- tibble(method = "kNN (k=5)", RMSE = NA, MAE = NA, R2 = NA)
}
cat("\nRunning MICE imputation (m=5 datasets, maxit=10)...\n")
df_for_mice <- df_final %>% select(where(is.numeric))
mice_imp <- tryCatch(
mice(df_for_mice, m = 5, maxit = 10, method = "pmm",
seed = 42, printFlag = FALSE),
error = function(e) {
message("MICE failed: ", conditionMessage(e))
NULL
}
)
if (!is.null(mice_imp)) {
# Pool: take mean across the 5 imputed datasets
df_mice_imp <- df_final
imputed_matrix <- Reduce("+", lapply(1:5, function(i) complete(mice_imp, i))) / 5
df_mice_imp[, names(imputed_matrix)] <- imputed_matrix
results_list[["MICE (PMM)"]] <- evaluate_imputation(df_mice_imp, TARGET, "MICE (PMM)")
} else {
results_list[["MICE (PMM)"]] <- tibble(method = "MICE (PMM)", RMSE = NA, MAE = NA, R2 = NA)
}
cat("\nRunning Random Forest imputation...\n")
df_for_rf <- df_final %>% select(where(is.numeric))
rf_imp <- tryCatch(
mice(df_for_rf, m = 1, maxit = 5, method = "rf",
seed = 42, printFlag = FALSE),
error = function(e) {
message("RF imputation failed: ", conditionMessage(e))
NULL
}
)
if (!is.null(rf_imp)) {
df_rf_imp <- df_final
rf_completed <- complete(rf_imp, 1)
df_rf_imp[, names(rf_completed)] <- rf_completed
results_list[["Random Forest Imp."]] <- evaluate_imputation(df_rf_imp, TARGET, "Random Forest Imp.")
} else {
results_list[["Random Forest Imp."]] <- tibble(method = "Random Forest Imp.", RMSE = NA, MAE = NA, R2 = NA)
}
cat("\n\n=== IMPUTATION METHOD COMPARISON (5-fold CV Random Forest) ===\n")
comparison_df <- bind_rows(results_list) %>%
arrange(RMSE)
print(comparison_df, n = Inf)
best_method <- comparison_df %>%
filter(!is.na(RMSE)) %>%
slice(1) %>%
pull(method)
print(base_method)
cat("=== results_list contents ===\n")
print(results_list)
comparison_df <- bind_rows(results_list) %>%
arrange(RMSE)
cat("\n=== IMPUTATION METHOD COMPARISON ===\n")
