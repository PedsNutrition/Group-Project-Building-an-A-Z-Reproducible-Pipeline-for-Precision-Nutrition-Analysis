writeLines(
'evaluate_imputation <- function(data, TARGET, label) {
message("Evaluating: ", label)
model_data <- data |> dplyr::select(dplyr::all_of(TARGET), where(is.numeric)) |> tidyr::drop_na()
if (nrow(model_data) < 30) {
return(tibble::tibble(method = label, RMSE = NA_real_, MAE = NA_real_, R2 = NA_real_))
}
set.seed(42)
ctrl <- caret::trainControl(method = "cv", number = 5, verboseIter = FALSE, savePredictions = "final")
model <- tryCatch(
caret::train(as.formula(paste(TARGET, "~ .")), data = model_data, method = "rf", trControl = ctrl, ntree = 100),
error = function(e) { message("Model failed: ", e$message); NULL }
)
if (is.null(model)) return(tibble::tibble(method = label, RMSE = NA_real_, MAE = NA_real_, R2 = NA_real_))
best_row <- model$results |> dplyr::arrange(RMSE) |> dplyr::slice(1)
mae_val <- tryCatch(mean(abs(model$pred$obs - model$pred$pred)), error = function(e) NA_real_)
tibble::tibble(method = label, RMSE = round(best_row$RMSE, 4), MAE = round(mae_val, 4), R2 = round(best_row$Rsquared, 4))
}',
"evaluate_imputation.R"
)
