# --- 9. GUIDANCE -------------------------------------------------------------

cat("\n=== GUIDANCE ON CHOOSING AN IMPUTATION METHOD ===\n")
cat("
  Complete Case   — Safe baseline; loses data. Use when missingness < 5%.
  Mean/Mode       — Fast, but distorts distributions. Avoid if >10% missing.
  Median/Mode     — Better than mean for skewed variables.
  kNN (k=5)       — Preserves local structure. Good for MCAR / MAR data.
  MICE (PMM)      — Gold standard for MAR. Respects uncertainty via pooling.
  Random Forest   — Handles nonlinear relationships; slower but powerful.

  MCAR = Missing Completely At Random   (no pattern)
  MAR  = Missing At Random              (pattern depends on observed vars)
  MNAR = Missing Not At Random          (pattern depends on missing values)
\n")
