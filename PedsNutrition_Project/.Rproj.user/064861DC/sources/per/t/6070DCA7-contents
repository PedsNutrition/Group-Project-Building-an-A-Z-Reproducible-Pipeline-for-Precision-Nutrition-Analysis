# --- 4. HELPER: EVALUATE MODEL -----------------------------------------------
# FIX: was referencing df_final inside function instead of the 'data' argument
# FIX: was referencing 'target' (lowercase) inconsistently
# FIX: removed broken %||% usage on results$MAEfinal (column doesn't exist)

evaluate_imputation <- function(data, TARGET, label) {
  message("Evaluating: ", label, " ...")

  # Use the 'data' argument (not the global df_final)
  model_data <- data %>%
    select(all_of(TARGET), where(is.numeric)) %>%
    drop_na()

  if (nrow(model_data) < 30) {
    warning(label, " — too few rows after cleaning. Skipping.")
    return(tibble(method = label, RMSE = NA_real_, MAE = NA_real_, R2 = NA_real_))
  }

  set.seed(42)
  ctrl <- trainControl(method = "cv", number = 5,
                       verboseIter = FALSE,
                       savePredictions = "final")

  formula_obj <- as.formula(paste(TARGET, "~ ."))

  model <- tryCatch(
    train(formula_obj, data = model_data,
          method     = "rf",
          trControl  = ctrl,
          importance = FALSE,
          ntree      = 100),
    error = function(e) {
      message("  Model failed: ", conditionMessage(e))
      NULL
    }
  )

  if (is.null(model)) {
    return(tibble(method = label, RMSE = NA_real_, MAE = NA_real_, R2 = NA_real_))
  }

  best_row <- model$results %>%
    arrange(RMSE) %>%
    slice(1)

  # FIX: compute MAE from saved predictions instead of non-existent column
  mae_val <- tryCatch({
    preds <- model$pred %>% arrange(rowIndex) %>% slice(1:nrow(.))
    mean(abs(preds$obs - preds$pred))
  }, error = function(e) NA_real_)

  tibble(
    method = label,
    RMSE   = round(best_row$RMSE,     4),
    MAE    = round(mae_val,            4),
    R2     = round(best_row$Rsquared, 4)
  )
}

# --- 5. IMPUTATION STRATEGIES ------------------------------------------------

results_list <- list()

## 5a. Complete Case -----------------------------------------------------------
df_complete <- df_final %>% drop_na()
cat("\nComplete cases:", nrow(df_complete), "of", nrow(df_final),
    sprintf("(%.1f%%)\n", 100 * nrow(df_complete) / nrow(df_final)))
results_list[["Complete Case"]] <- evaluate_imputation(df_complete, TARGET, "Complete Case")

## 5b. Mean / Mode -------------------------------------------------------------
mode_val <- function(x) {
  ux <- na.omit(unique(x))
  ux[which.max(tabulate(match(x, ux)))]
}

df_mean_imp <- df_final %>%
  mutate(
    across(where(is.numeric),   ~ ifelse(is.na(.), mean(., na.rm = TRUE), .)),
    across(where(is.character),  ~ ifelse(is.na(.), mode_val(.), .)),
    across(where(is.factor),     ~ factor(ifelse(is.na(.), as.character(mode_val(.)), as.character(.)),
                                          levels = levels(.)))
  )
results_list[["Mean/Mode"]] <- evaluate_imputation(df_mean_imp, TARGET, "Mean/Mode")

## 5c. Median / Mode -----------------------------------------------------------
df_median_imp <- df_final %>%
  mutate(
    across(where(is.numeric),   ~ ifelse(is.na(.), median(., na.rm = TRUE), .)),
    across(where(is.character),  ~ ifelse(is.na(.), mode_val(.), .)),
    across(where(is.factor),     ~ factor(ifelse(is.na(.), as.character(mode_val(.)), as.character(.)),
                                          levels = levels(.)))
  )
results_list[["Median/Mode"]] <- evaluate_imputation(df_median_imp, TARGET, "Median/Mode")

## 5d. kNN (VIM) ---------------------------------------------------------------
cat("\nRunning kNN imputation (k=5)...\n")
df_knn_imp <- tryCatch(
  VIM::kNN(df_final, k = 5, imp_var = FALSE),
  error = function(e) { message("kNN failed: ", e$message); NULL }
)

results_list[["kNN (k=5)"]] <- if (!is.null(df_knn_imp)) {
  evaluate_imputation(df_knn_imp, TARGET, "kNN (k=5)")
} else {
  tibble(method = "kNN (k=5)", RMSE = NA_real_, MAE = NA_real_, R2 = NA_real_)
}

## 5e. MICE (PMM) --------------------------------------------------------------
cat("\nRunning MICE imputation (m=5, maxit=10)...\n")
df_for_mice <- df_final %>% select(where(is.numeric))

mice_imp <- tryCatch(
  mice(df_for_mice, m = 5, maxit = 10, method = "pmm",
       seed = 42, printFlag = FALSE),
  error = function(e) { message("MICE failed: ", e$message); NULL }
)

if (!is.null(mice_imp)) {
  df_mice_imp <- df_final
  imputed_matrix <- Reduce("+", lapply(1:5, function(i) complete(mice_imp, i))) / 5
  df_mice_imp[, names(imputed_matrix)] <- imputed_matrix
  results_list[["MICE (PMM)"]] <- evaluate_imputation(df_mice_imp, TARGET, "MICE (PMM)")
} else {
  results_list[["MICE (PMM)"]] <- tibble(method = "MICE (PMM)", RMSE = NA_real_, MAE = NA_real_, R2 = NA_real_)
}

## 5f. Random Forest Imputation ------------------------------------------------
cat("\nRunning Random Forest imputation...\n")
df_for_rf <- df_final %>% select(where(is.numeric))

rf_imp <- tryCatch(
  mice(df_for_rf, m = 1, maxit = 5, method = "rf",
       seed = 42, printFlag = FALSE),
  error = function(e) { message("RF imputation failed: ", e$message); NULL }
)

if (!is.null(rf_imp)) {
  df_rf_imp <- df_final
  df_rf_imp[, names(complete(rf_imp, 1))] <- complete(rf_imp, 1)
  results_list[["Random Forest Imp."]] <- evaluate_imputation(df_rf_imp, TARGET, "Random Forest Imp.")
} else {
  results_list[["Random Forest Imp."]] <- tibble(method = "Random Forest Imp.", RMSE = NA_real_, MAE = NA_real_, R2 = NA_real_)
}

# --- 6. COMPARE RESULTS ------------------------------------------------------

