# Define colors matched to discrete k values
k_levels <- sort(unique(index_matrix$Optimal_k))
k_colors <- setNames(
colorRampPalette(c("#D7191C","#F46D43","#FEC74B","#C2D14E","#6DB86B","#4575B4"))(length(k_levels)),
as.character(k_levels)
)
# Override specific known values to match image exactly
k_colors["0"]  <- "#D7191C"
k_colors["2"]  <- "#F46D43"
k_colors["3"]  <- "#FEC74B"
k_colors["4"]  <- "#C2D14E"
k_colors["9"]  <- "#6DB86B"
k_colors["12"] <- "#4575B4"
plot6 <- ggplot(index_matrix,
aes(x = Optimal_k, y = Index)) +
geom_tile(aes(fill = as.factor(Optimal_k)),
color = "white", linewidth = 1,
width = 0.6,   # narrow tile so it doesn't bleed into neighbours
height = 0.85) +
geom_text(aes(label = Optimal_k),
color = "white", fontface = "bold", size = 4) +
scale_fill_manual(values = k_colors,
breaks = as.character(sort(unique(index_matrix$Optimal_k))),
name   = "Optimal k") +
scale_x_continuous(
breaks = 2:max(c(8, index_matrix$Optimal_k)),
limits = c(min(index_matrix$Optimal_k) - 0.5,
max(index_matrix$Optimal_k) + 0.5),
expand = c(0.02, 0)
) +
labs(
title    = "F. Individual Index Recommendations",
subtitle = "Each row shows one index's vote for optimal k",
x        = "Recommended Number of Clusters",
y        = "Statistical Index"
) +
theme_minimal(base_size = 14) +
theme(
plot.title      = element_text(face = "bold", size = 20, hjust = 0.5),
plot.subtitle   = element_text(size = 14, color = "grey30", hjust = 0.5,
margin = margin(b = 10)),
axis.title      = element_text(face = "bold", size = 16),
axis.text.x     = element_text(size = 13, face = "bold"),
axis.text.y     = element_text(size = 10),
legend.position = "right",
legend.title    = element_text(face = "bold", size = 14),
panel.grid      = element_blank(),
plot.margin     = margin(20, 20, 20, 20)
)
print(plot6)
