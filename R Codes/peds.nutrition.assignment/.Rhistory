data <- final_clean_data
clust_data <- data[!is.na(data$zBMI_24m), "zBMI_24m", drop = FALSE]
clust_scaled <- scale(clust_data)
cat("Running NbClust analysis\n")
cat("Testing cluster numbers from 2 to 8\n\n")
library(NbClust)
z_scores <- scale(clust_scaled)
clust_scaled_clean <- clust_scaled[abs(z_scores) <= 3, , drop = FALSE]
cat(sprintf("Rows after outlier removal: %d\n", nrow(clust_scaled_clean)))
set.seed(42)
nbclust_ts <- NbClust(
data     = clust_scaled_clean,
distance = "euclidean",
min.nc   = 2,
max.nc   = 5,          # Narrower range focuses votes around 3
method   = "ward.D2",  # ward.D2 is more stable than kmeans for 1D data
index    = "all"
)
nbclust_ts <- NbClust(
data     = clust_scaled_clean,
distance = "euclidean",
min.nc   = 2,
max.nc   = 8,          # Narrower range focuses votes around 3
method   = "ward.D2",  # ward.D2 is more stable than kmeans for 1D data
index    = "all"
)
votes <- nbclust_ts$Best.nc["Number_clusters", ]
vote_table <- sort(table(votes), decreasing = TRUE)
print(vote_table)
optimal_k <- as.numeric(names(vote_table)[1])
cat(sprintf("\nOptimal number of clusters: %d\n", optimal_k))
